# Copy to .env and fill in. run.sh / run.bat load this file. Never commit .env.

# Free key from https://aistudio.google.com/apikey  (leave empty to use the offline mock model)
GEMINI_API_KEY=
# gemini | ollama | mock
LLM_PROVIDER=
GEMINI_MODEL=gemini-flash-latest

# Local model alternative (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Comma-separated user:password pairs (password may be {SHA-256}<hex>)
TRANSLATOR_USERS=student:darija2026
PORT=8080
